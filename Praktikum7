import numpy as np
import matplotlib.pyplot as plt
import pandas as pd

# 1. Fungsi Keanggotaan Segitiga
def trimf(x, params):
    """
    trimf(x, [a, b, c])
    a = titik awal naik
    b = puncak
    c = titik akhir turun
    """
    a, b, c = params
    y = np.zeros_like(x)
    idx1 = (x > a) & (x <= b)
    if np.any(idx1) and b != a:
        y[idx1] = (x[idx1] - a) / (b - a)
    idx2 = (x > b) & (x < c)
    if np.any(idx2) and c != b:
        y[idx2] = (c - x[idx2]) / (c - b)
    return np.clip(y, 0.0, 1.0)

# 2. Kelas Fuzzy Inference System Mamdani
class FuzzyInferenceSystem:
    def __init__(self):
        self.input_vars = {}
        self.output_var = None
        self.rules = []

    def add_input_variable(self, name, universe, mf_dict):
        self.input_vars[name] = {
            "universe": np.array(universe),
            "mf_dict": mf_dict
        }

    def set_output_variable(self, name, universe, mf_dict):
        self.output_var = {
            "name": name,
            "universe": np.array(universe),
            "mf_dict": mf_dict
        }

    def add_rule(self, rule_tuple):
        """
        rule_tuple = ((input1_name, mf1_name), (input2_name, mf2_name), output_mf_name)
        """
        self.rules.append(rule_tuple)

    def get_mu_value(self, var_name, mf_name, crisp_value):
        var = self.input_vars[var_name]
        universe = var["universe"]
        params = var["mf_dict"][mf_name]
        idx = np.argmin(np.abs(universe - crisp_value))
        return float(trimf(universe, params)[idx])

    def compute(self, input_values_dict):
        if self.output_var is None:
            raise ValueError("Variabel output belum diatur!")
        z = self.output_var["universe"]
        mf_output_dict = self.output_var["mf_dict"]
        all_implication = []
        firing_list = []

        for rule in self.rules:
            (in1_name, mf1_name), (in2_name, mf2_name), out_mf_name = rule
            x1 = input_values_dict[in1_name]
            x2 = input_values_dict[in2_name]
            mu1 = self.get_mu_value(in1_name, mf1_name, x1)
            mu2 = self.get_mu_value(in2_name, mf2_name, x2)
            alpha = min(mu1, mu2)
            mf_out = trimf(z, mf_output_dict[out_mf_name])
            impl = np.minimum(alpha, mf_out)
            all_implication.append(impl)
            firing_list.append({
                "Aturan": f"IF {in1_name}={mf1_name} AND {in2_name}={mf2_name} THEN NilaiAkhir={out_mf_name}",
                "μ(Rapor)": round(mu1,4),
                "μ(TesTulis)": round(mu2,4),
                "α (Firing Strength)": round(alpha,4)
            })

        agregasi = np.max(all_implication, axis=0)
        total_mu = np.sum(agregasi)
        fallback = False
        if total_mu == 0:
            crisp_output = 0.0
            fallback = True
        else:
            crisp_output = np.sum(z * agregasi) / total_mu
        return crisp_output, agregasi, z, firing_list, fallback

# 3. Definisi Semesta & Fungsi Keanggotaan
# Input 1: Nilai Rapor
x_rapor = np.linspace(0, 100, 300)
mf_rapor = {
    "Rendah": [0, 25, 50],
    "Sedang": [25, 50, 75],
    "Tinggi": [50, 75, 100]
}

# Input 2: Nilai Tes Tulis
x_tes = np.linspace(0, 100, 300)
mf_tes = {
    "Rendah": [0, 25, 50],
    "Sedang": [25, 50, 75],
    "Tinggi": [50, 75, 100]
}

# Output: Nilai Akhir Seleksi
z_nilai = np.linspace(0, 100, 300)
mf_nilai_akhir = {
    "Rendah": [0, 25, 50],
    "Sedang": [25, 50, 75],
    "Tinggi": [50, 75, 100]
}
# 4. Inisialisasi FIS + Tambah 9 Aturan
fis_seleksi = FuzzyInferenceSystem()
fis_seleksi.add_input_variable("Nilai_Rapor", x_rapor, mf_rapor)
fis_seleksi.add_input_variable("Nilai_TesTulis", x_tes, mf_tes)
fis_seleksi.set_output_variable("Nilai_Akhir", z_nilai, mf_nilai_akhir)

fis_seleksi.add_rule((("Nilai_Rapor", "Rendah"), ("Nilai_TesTulis", "Rendah"), "Rendah"))
fis_seleksi.add_rule((("Nilai_Rapor", "Rendah"), ("Nilai_TesTulis", "Sedang"), "Rendah"))
fis_seleksi.add_rule((("Nilai_Rapor", "Rendah"), ("Nilai_TesTulis", "Tinggi"), "Sedang"))
fis_seleksi.add_rule((("Nilai_Rapor", "Sedang"), ("Nilai_TesTulis", "Rendah"), "Rendah"))
fis_seleksi.add_rule((("Nilai_Rapor", "Sedang"), ("Nilai_TesTulis", "Sedang"), "Sedang"))
fis_seleksi.add_rule((("Nilai_Rapor", "Sedang"), ("Nilai_TesTulis", "Tinggi"), "Tinggi"))
fis_seleksi.add_rule((("Nilai_Rapor", "Tinggi"), ("Nilai_TesTulis", "Rendah"), "Sedang"))
fis_seleksi.add_rule((("Nilai_Rapor", "Tinggi"), ("Nilai_TesTulis", "Sedang"), "Tinggi"))
fis_seleksi.add_rule((("Nilai_Rapor", "Tinggi"), ("Nilai_TesTulis", "Tinggi"), "Tinggi"))

# 5. Uji 3 Kasus
kasus_list = [
    {"nama": "Kasus 1", "Nilai_Rapor": 30, "Nilai_TesTulis": 20},
    {"nama": "Kasus 2", "Nilai_Rapor": 50, "Nilai_TesTulis": 55},
    {"nama": "Kasus 3", "Nilai_Rapor": 80, "Nilai_TesTulis": 85}
]

hasil_kasus = []
for kasus in kasus_list:
    crisp_out, agregasi, z, firing, fallback = fis_seleksi.compute({
        "Nilai_Rapor": kasus["Nilai_Rapor"],
        "Nilai_TesTulis": kasus["Nilai_TesTulis"]
    })
    print("\n======== " + kasus["nama"] + " ========")
