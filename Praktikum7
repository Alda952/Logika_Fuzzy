        "Kasus": kasus["nama"],
        "Nilai Rapor": kasus["Nilai_Rapor"],
        "Nilai Tes Tulis": kasus["Nilai_TesTulis"],
        "Nilai Akhir Seleksi": round(crisp_out,2),
