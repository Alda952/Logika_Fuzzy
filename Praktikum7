# 6. Visualisasi Semua 3 Kasus
fig, axes = plt.subplots(1, 3, figsize=(18, 6))
for i, kasus in enumerate(kasus_list):
    crisp_out, agregasi, z, _, _ = fis_seleksi.compute({
        "Nilai_Rapor": kasus["Nilai_Rapor"],
        "Nilai_TesTulis": kasus["Nilai_TesTulis"]
    })
    axes[i].plot(z, trimf(z, mf_nilai_akhir["Rendah"]), "g--", label="MF Rendah", alpha=0.5)
    axes[i].plot(z, trimf(z, mf_nilai_akhir["Sedang"]), "b--", label="MF Sedang", alpha=0.5)
    axes[i].plot(z, trimf(z, mf_nilai_akhir["Tinggi"]), "r--", label="MF Tinggi", alpha=0.5)
    axes[i].fill_between(z, 0, agregasi, color="purple", alpha=0.35, label="Daerah Agregasi Fuzzy")
    axes[i].plot(z, agregasi, color="purple", linewidth=2.5)
    axes[i].axvline(x=crisp_out, color="black", linewidth=2.5, linestyle="-", label="Centroid=" + str(round(crisp_out,2)))
    axes[i].set_title(kasus["nama"] + ": Rapor=" + str(kasus["Nilai_Rapor"]) + ", TesTulis=" + str(kasus["Nilai_TesTulis"]), fontsize=11)
    axes[i].set_xlabel("Nilai Akhir Seleksi")
    axes[i].set_ylabel("μ(z)")
    axes[i].set_ylim(-0.05, 1.05)
    axes[i].grid(True, linestyle=":", alpha=0.6)
    axes[i].legend(loc="upper left")

